{
  "name": "antora-extensions-registry",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build && node scripts/stage-netlify-in-dist.mjs",
    "start": "vinxi start",
    "lint": "eslint --fix \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "docs:build": "pnpm exec antora antora-playbook.yml",
    "db:push": "pnpm exec drizzle-kit push",
    "db:studio": "pnpm exec drizzle-kit studio",
    "seed": "pnpm exec tsx scripts/seed.ts",
    "discover:github-topics": "pnpm exec tsx scripts/github-topic-discovery.ts",
    "extensions:sync": "node scripts/sync-extension-catalog.mjs",
    "apply:registry-topics": "node scripts/apply-registry-topics.mjs --discover",
    "catalog:snapshot": "tsx scripts/build-catalog-snapshot.ts",
    "catalog:sync": "tsx scripts/sync-catalog-db.ts",
    "test": "tsx --test tests/preview-images.test.ts tests/extension-deps.test.ts tests/bundle-members.test.ts tests/fork-groups.test.ts tests/preview-cache.test.ts tests/layers.test.ts tests/preview-route.test.ts tests/gitlab-owners.test.ts tests/browse-cache.test.ts tests/thumb-actions.test.ts tests/antora-compat.test.ts tests/pkg-compat.test.ts tests/theme-variants.test.ts",
    "audit:previews": "tsx scripts/audit-previews.ts"
  },
  "type": "module",
  "devDependencies": {
    "@antora/cli": "^3.1.14",
    "@antora/lunr-extension": "1.0.0-alpha.13",
    "@antora/site-generator": "^3.1.14",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.0",
    "eslint-plugin-solid": "^0.14.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.46.0",
    "uuid": "^13.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@asciidoctor/core": "^4.1.1",
    "@kobalte/core": "^0.13.14",
    "@libsql/client": "^0.17.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.1",
    "@solidjs/start": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.19",
    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "json5": "^2.2.3",
    "pathe": "^2.0.3",
    "postcss": "^8.4.40",
    "solid-js": "^1.9.5",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.7",
    "vinxi": "^0.5.7",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=22"
  }
}
