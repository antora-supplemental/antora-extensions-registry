{
  "name": "antora-extensions-registry",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "lint": "eslint --fix \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "docs:build": "pnpm exec antora antora-playbook.yml",
    "db:push": "pnpm exec drizzle-kit push",
    "db:studio": "pnpm exec drizzle-kit studio",
    "seed": "pnpm exec tsx scripts/seed.ts",
    "discover:github-topics": "pnpm exec tsx scripts/github-topic-discovery.ts",
    "extensions:sync": "node scripts/sync-extension-catalog.mjs",
    "apply:registry-topics": "node scripts/apply-registry-topics.mjs --discover"
  },
  "type": "module",
  "devDependencies": {
    "@antora/cli": "^3.1.14",
    "@antora/site-generator": "^3.1.14",
    "@types/node": "^24.7.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^8.56.0",
    "eslint-plugin-solid": "^0.14.3",
    "tsx": "^4.21.0",
    "typescript": "^5.6.2",
    "uuid": "^13.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@libsql/client": "^0.17.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.1",
    "@solidjs/start": "^1.1.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.19",
    "better-auth": "^1.6.16",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.3",
    "json5": "^2.2.3",
    "postcss": "^8.4.40",
    "solid-js": "^1.9.5",
    "tailwindcss": "^3.4.7",
    "vinxi": "^0.5.7",
    "zod": "^3.22.4"
  },
  "engines": {
    "node": ">=22"
  }
}
