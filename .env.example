# Auth (Better Auth)
BETTER_AUTH_SECRET=changeme-generate-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Production: https://registry.antora-supplemental.org
# Comma-separated production origins, e.g. https://registry.antora-supplemental.org
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth providers (configure only the providers you need)
GITHUB_ID=
GITHUB_SECRET=
# GitLab sign-in uses OpenID Connect (scopes: openid profile email).
# Redirect URI to register in GitLab: <BETTER_AUTH_URL>/api/auth/oauth2/callback/gitlab
GITLAB_ID=
GITLAB_SECRET=
# Optional, for self-managed GitLab (default https://gitlab.com)
# GITLAB_ISSUER=https://gitlab.example.com
GOOGLE_ID=
GOOGLE_SECRET=
MICROSOFT_ID=
MICROSOFT_SECRET=
APPLE_CLIENT_ID=
# Generate with: pnpm exec tsx scripts/generate-apple-client-secret.ts
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Only needed by the generator script:
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Magic link email (optional — enables email sign-in when both are set)
# Auth email (magic link, verification, password reset) is sent with Resend: needs RESEND_API_KEY and EMAIL_FROM.
# EMAIL_FROM must be on a domain verified in Resend.
EMAIL_FROM=noreply@example.com
# Feature flag: true = require email verification for password accounts; enables reset and linking a password to an existing account.
AUTH_EMAIL_VERIFICATION=false

# Database
# Local development:
DB_URL=file:local.db
# Production (Turso / LibSQL — required on Netlify; file: databases do not persist):
# DB_URL=libsql://your-database-name-org.turso.io
# DB_AUTH_TOKEN=your-turso-auth-token

# Comma-separated GitHub logins allowed into /admin:
ADMIN_GITHUB_LOGINS=AMDphreak

# Report emails via Resend (optional; reports are stored either way):
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Defaults to support@antora-supplemental.org
REPORT_EMAIL_TO=
